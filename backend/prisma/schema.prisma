datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TipoUnidad {
  SECCION_RAMA
  JEFATURA
  SIN_RAMA_APOYO
}

enum AlcanceRol {
  PROPIO
  UNIDAD
  GLOBAL
}

enum EstadoEntrega {
  BORRADOR
  PENDIENTE_FIRMA_FISICA
  VALIDADO_FISICAMENTE
  DESACTUALIZADO_REQUIERE_REIMPRESION
}

enum EstadoCargo {
  PENDIENTE
  PARCIAL
  PAGADO
  ANULADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  OTRO
}

enum TipoCuenta {
  CAJA_EFECTIVO
  BANCO
}

enum EstadoSolicitudPase {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

enum TipoMovimientoFinanciero {
  INGRESO_COBRANZA
  INGRESO_OTRO
  EGRESO_GASTO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
}

model Rama {
  id               Int                  @id @default(autoincrement())
  nombre           String               @db.VarChar(100)
  edadMinima       Int                  @map("edad_minima")
  edadMaxima       Int                  @map("edad_maxima")
  ordenProgresion  Int                  @map("orden_progresion")
  activa           Boolean              @default(true)
  unidades         UnidadOrganizativa[]

  @@map("ramas")
}

model UnidadOrganizativa {
  id           Int                 @id @default(autoincrement())
  nombre       String              @db.VarChar(120)
  tipo         TipoUnidad
  ramaId       Int?                @map("rama_id")
  activa       Boolean             @default(true)
  rama         Rama?               @relation(fields: [ramaId], references: [id], onDelete: SetNull)
  asignaciones AsignacionMiembro[]
  conceptos    ConceptoCuota[]
  planesCuota  PlanCuotaMensual[]
  rubros       RubroContable[]
  solicitudesPaseOrigen  SolicitudPase[] @relation("SolicitudesPaseOrigen")
  solicitudesPaseDestino SolicitudPase[] @relation("SolicitudesPaseDestino")

  @@map("unidades_organizativas")
}

model GrupoFamiliar {
  id                           Int       @id @default(autoincrement())
  nombreFamilia                String    @map("nombre_familia") @db.VarChar(150)
  porcentajeDescuentoHermanos  Decimal   @default(0.00) @map("porcentaje_descuento_hermanos") @db.Decimal(5, 2)
  miembros                     Usuario[]

  @@map("grupos_familiares")
}

model Usuario {
  id                  Int                 @id @default(autoincrement())
  dni                 String              @unique @db.VarChar(20)
  passwordHash        String              @map("password_hash") @db.VarChar(255)
  nombre              String              @db.VarChar(100)
  apellido            String              @db.VarChar(100)
  fechaNacimiento     DateTime            @map("fecha_nacimiento") @db.Date
  emailContacto       String?             @map("email_contacto") @db.VarChar(150) // NO UNIQUE!
  telefonoContacto    String?             @map("telefono_contacto") @db.VarChar(50)
  grupoFamiliarId     Int?                @map("grupo_familiar_id")
  datosFijosJson      Json                @default("{}") @map("datos_fijos_json")
  requiereCambioClave Boolean             @default(true) @map("requiere_cambio_clave")
  tokenVersion        Int                 @default(1) @map("token_version")
  activo              Boolean             @default(true)
  saldoAFavor         Decimal             @default(0.00) @map("saldo_a_favor") @db.Decimal(12, 2)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  grupoFamiliar       GrupoFamiliar?      @relation(fields: [grupoFamiliarId], references: [id], onDelete: SetNull)
  asignaciones        AsignacionMiembro[]
  entregas            EntregaFormulario[] @relation("EntregasPropias")
  entregasValidadas   EntregaFormulario[] @relation("EntregasValidadas")
  cargos              CargoMiembro[]
  pagosRegistrados    Pago[]                 @relation("PagosRegistrados")
  pagosTitular        Pago[]                 @relation("PagosTitular")
  movimientosCreados  MovimientoFinanciero[] @relation("MovimientosCreados")
  gastosRegistrados   Gasto[]                @relation("GastosRegistrados")
  eventosCreados      Evento[]               @relation("EventosCreados")
  pedidosVendidos        PedidoEvento[]         @relation("PedidosVendidos")
  pedidosRegistrados     PedidoEvento[]         @relation("PedidosRegistrados")
  ticketsValidados       TicketEvento[]         @relation("TicketsValidados")
  conceptosExcepcion     ConceptoExcepcion[]
  planesCuotaExcepcion   PlanCuotaExcepcion[]
  solicitudesPaseMiembro     SolicitudPase[] @relation("SolicitudesPaseMiembro")
  solicitudesPaseSolicitadas SolicitudPase[] @relation("SolicitudesPaseSolicitadas")
  solicitudesPaseResueltas   SolicitudPase[] @relation("SolicitudesPaseResueltas")

  @@index([grupoFamiliarId])
  @@map("usuarios")
}

model Rol {
  id                Int                 @id @default(autoincrement())
  nombre            String              @unique @db.VarChar(80)
  alcancePorDefecto AlcanceRol          @map("alcance_por_defecto")
  tipoMiembro       String              @default("EDUCADOR") @map("tipo_miembro") @db.VarChar(30)
  requiereRama      Boolean             @default(true) @map("requiere_rama")
  esSistema         Boolean             @default(false) @map("es_sistema")
  permisos          RolPermiso[]
  asignaciones      AsignacionMiembro[]
  solicitudesPase   SolicitudPase[]

  @@map("roles")
}

model Permiso {
  id          Int          @id @default(autoincrement())
  clave       String       @unique @db.VarChar(100)
  descripcion String?      @db.VarChar(255)
  roles       RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     Int     @map("rol_id")
  permisoId Int     @map("permiso_id")
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model AsignacionMiembro {
  id              Int                @id @default(autoincrement())
  usuarioId       Int                @map("usuario_id")
  unidadId        Int                @map("unidad_id")
  rolId           Int                @map("rol_id")
  alcanceOverride AlcanceRol?        @map("alcance_override")
  camada          Int?
  cicloAnio       Int                @map("ciclo_anio")
  fechaInicio     DateTime           @default(now()) @map("fecha_inicio") @db.Date
  fechaFin        DateTime?          @map("fecha_fin") @db.Date
  activo          Boolean            @default(true)

  usuario         Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  unidad          UnidadOrganizativa @relation(fields: [unidadId], references: [id])
  rol             Rol                @relation(fields: [rolId], references: [id])
  solicitudesPase SolicitudPase[]

  @@index([usuarioId, activo])
  @@index([unidadId, activo])
  @@map("asignaciones_miembro")
}

model SolicitudPase {
  id                 Int                 @id @default(autoincrement())
  asignacionOrigenId Int                 @map("asignacion_origen_id")
  usuarioId          Int                 @map("usuario_id")
  unidadOrigenId     Int                 @map("unidad_origen_id")
  unidadDestinoId    Int                 @map("unidad_destino_id")
  rolDestinoId       Int                 @map("rol_destino_id")
  alcanceOverride    AlcanceRol?         @map("alcance_override")
  modo               String              @default("MOVER") @db.VarChar(20)
  estado             EstadoSolicitudPase @default(PENDIENTE)
  solicitadoPorId    Int                 @map("solicitado_por_id")
  resueltoPorId      Int?                @map("resuelto_por_id")
  motivoRechazo      String?             @map("motivo_rechazo") @db.VarChar(255)
  createdAt          DateTime            @default(now()) @map("created_at")
  resueltoAt         DateTime?           @map("resuelto_at")

  asignacionOrigen   AsignacionMiembro   @relation(fields: [asignacionOrigenId], references: [id], onDelete: Cascade)
  usuario            Usuario             @relation("SolicitudesPaseMiembro", fields: [usuarioId], references: [id], onDelete: Cascade)
  unidadOrigen       UnidadOrganizativa  @relation("SolicitudesPaseOrigen", fields: [unidadOrigenId], references: [id])
  unidadDestino      UnidadOrganizativa  @relation("SolicitudesPaseDestino", fields: [unidadDestinoId], references: [id])
  rolDestino         Rol                 @relation(fields: [rolDestinoId], references: [id])
  solicitadoPor      Usuario             @relation("SolicitudesPaseSolicitadas", fields: [solicitadoPorId], references: [id])
  resueltoPor        Usuario?            @relation("SolicitudesPaseResueltas", fields: [resueltoPorId], references: [id])

  @@index([estado, unidadDestinoId])
  @@index([estado, unidadOrigenId])
  @@index([asignacionOrigenId, estado])
  @@index([usuarioId, estado])
  @@map("solicitudes_pase")
}

model PlantillaFormulario {
  id                 Int                 @id @default(autoincrement())
  codigo             String              @db.VarChar(50)
  titulo             String              @db.VarChar(150)
  version            String              @db.VarChar(20)
  cicloAnio          Int                 @map("ciclo_anio")
  esquemaCamposJson  Json                @map("esquema_campos_json")
  mapeoPdfJson       Json                @map("mapeo_pdf_json")
  activa             Boolean             @default(true)
  entregas           EntregaFormulario[]

  @@unique([codigo, cicloAnio])
  @@map("plantillas_formulario")
}

model EntregaFormulario {
  id                     Int                 @id @default(autoincrement())
  usuarioId              Int                 @map("usuario_id")
  plantillaId            Int                 @map("plantilla_id")
  cicloAnio              Int                 @map("ciclo_anio")
  versionImpresion       Int                 @default(1) @map("version_impresion")
  respuestasSnapshotJson Json                @map("respuestas_snapshot_json")
  hashVerificacion       String              @unique @map("hash_verificacion") @db.VarChar(64)
  estado                 EstadoEntrega       @default(BORRADOR)
  fechaGeneracionPdf     DateTime?           @map("fecha_generacion_pdf")
  fechaValidacionFisica  DateTime?           @map("fecha_validacion_fisica")
  validadoPorUsuarioId   Int?                @map("validado_por_usuario_id")

  usuario                Usuario             @relation("EntregasPropias", fields: [usuarioId], references: [id], onDelete: Cascade)
  plantilla              PlantillaFormulario @relation(fields: [plantillaId], references: [id])
  validadoPor            Usuario?            @relation("EntregasValidadas", fields: [validadoPorUsuarioId], references: [id])

  @@unique([usuarioId, plantillaId, cicloAnio])
  @@map("entregas_formulario")
}

model ConceptoCuota {
  id                          Int                 @id @default(autoincrement())
  nombre                      String              @db.VarChar(120)
  tipo                        String              @default("CUOTA_MENSUAL") @db.VarChar(50)
  montoBase                   Decimal             @map("monto_base") @db.Decimal(12, 2)
  cicloAnio                   Int                 @map("ciclo_anio")
  fechaVencimiento            DateTime?           @map("fecha_vencimiento") @db.Date
  permiteDescuentoHermanos    Boolean             @default(true) @map("permite_descuento_hermanos")
  porcentajeDescuentoHermanos Decimal?            @map("porcentaje_descuento_hermanos") @db.Decimal(5, 2)
  esParaEducadores            Boolean             @default(false) @map("es_para_educadores")
  planCuotaMensualId          Int?                @map("plan_cuota_mensual_id")
  mes                         Int?                @map("mes")
  destinatarioTipo            String              @default("TODOS") @map("destinatario_tipo") @db.VarChar(30)
  unidadId                    Int?                @map("unidad_id")
  rubroId                     Int?                @map("rubro_id")
  unidad                      UnidadOrganizativa? @relation(fields: [unidadId], references: [id])
  rubro                       RubroContable?      @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  planCuotaMensual            PlanCuotaMensual?   @relation(fields: [planCuotaMensualId], references: [id], onDelete: Cascade)
  cargos                      CargoMiembro[]
  excepciones                 ConceptoExcepcion[]

  @@index([planCuotaMensualId, mes])
  @@index([cicloAnio])
  @@index([unidadId])
  @@map("conceptos_cuota")
}

model ConceptoExcepcion {
  conceptoId Int           @map("concepto_id")
  usuarioId  Int           @map("usuario_id")
  concepto   ConceptoCuota @relation(fields: [conceptoId], references: [id], onDelete: Cascade)
  usuario    Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([conceptoId, usuarioId])
  @@index([usuarioId])
  @@map("concepto_excepciones")
}

model CargoMiembro {
  id             Int              @id @default(autoincrement())
  usuarioId      Int              @map("usuario_id")
  conceptoId     Int              @map("concepto_id")
  montoOriginal  Decimal          @map("monto_original") @db.Decimal(12, 2)
  montoDescuento Decimal          @default(0.00) @map("monto_descuento") @db.Decimal(12, 2)
  montoFinal     Decimal          @map("monto_final") @db.Decimal(12, 2)
  montoPagado    Decimal          @default(0.00) @map("monto_pagado") @db.Decimal(12, 2)
  estado         EstadoCargo      @default(PENDIENTE)

  usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  concepto       ConceptoCuota    @relation(fields: [conceptoId], references: [id])
  imputaciones   PagoImputacion[]

  @@index([usuarioId, estado])
  @@index([conceptoId, estado])
  @@map("cargos_miembro")
}

model Pago {
  id                     Int              @id @default(autoincrement())
  fechaPago              DateTime         @default(now()) @map("fecha_pago")
  montoTotal             Decimal          @map("monto_total") @db.Decimal(12, 2)
  metodoPago             MetodoPago       @map("metodo_pago")
  referenciaComprobante  String?          @map("referencia_comprobante") @db.VarChar(100)
  registradoPorUsuarioId Int              @map("registrado_por_usuario_id")
  usuarioId              Int?             @map("usuario_id")
  observaciones          String?          @db.Text

  registradoPor          Usuario          @relation("PagosRegistrados", fields: [registradoPorUsuarioId], references: [id])
  usuario                Usuario?               @relation("PagosTitular", fields: [usuarioId], references: [id])
  imputaciones           PagoImputacion[]
  movimientos            MovimientoFinanciero[]

  @@index([usuarioId, fechaPago])
  @@index([fechaPago])
  @@map("pagos")
}

model PagoImputacion {
  id            Int          @id @default(autoincrement())
  pagoId        Int          @map("pago_id")
  cargoId       Int          @map("cargo_id")
  montoImputado Decimal      @map("monto_imputado") @db.Decimal(12, 2)

  pago          Pago         @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  cargo         CargoMiembro @relation(fields: [cargoId], references: [id])

  @@unique([pagoId, cargoId])
  @@index([cargoId])
  @@map("pago_imputaciones")
}

model PlanCuotaMensual {
  id                          Int                 @id @default(autoincrement())
  nombre                      String              @db.VarChar(150)
  cicloAnio                   Int                 @map("ciclo_anio")
  montoMensual                Decimal             @map("monto_mensual") @db.Decimal(12, 2)
  diaVencimiento              Int                 @default(10) @map("dia_vencimiento")
  mesesHabilitadosJson        Json                @default("[]") @map("meses_habilitados_json")
  destinatarioTipo            String              @default("PROTAGONISTAS") @map("destinatario_tipo") @db.VarChar(30)
  unidadId                    Int?                @map("unidad_id")
  permiteDescuentoHermanos    Boolean             @default(true) @map("permite_descuento_hermanos")
  porcentajeDescuentoHermanos Decimal?            @map("porcentaje_descuento_hermanos") @db.Decimal(5, 2)
  activa                      Boolean             @default(true)
  rubroId                     Int?                @map("rubro_id")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  unidad                      UnidadOrganizativa? @relation(fields: [unidadId], references: [id])
  rubro                       RubroContable?      @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  conceptos                   ConceptoCuota[]
  excepciones                 PlanCuotaExcepcion[]

  @@map("planes_cuota_mensual")
}

model PlanCuotaExcepcion {
  planCuotaMensualId Int              @map("plan_cuota_mensual_id")
  usuarioId          Int              @map("usuario_id")
  planCuotaMensual   PlanCuotaMensual @relation(fields: [planCuotaMensualId], references: [id], onDelete: Cascade)
  usuario            Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([planCuotaMensualId, usuarioId])
  @@index([usuarioId])
  @@map("plan_cuota_excepciones")
}

model CuentaFinanciera {
  id            Int                    @id @default(autoincrement())
  nombre        String                 @db.VarChar(100)
  tipo          TipoCuenta
  activa        Boolean                @default(true)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  movimientos   MovimientoFinanciero[]
  gastos        Gasto[]
  eventos       Evento[]
  pedidosEvento PedidoEvento[]

  @@map("cuentas_financieras")
}

model MovimientoFinanciero {
  id                 Int                      @id @default(autoincrement())
  cuentaId           Int                      @map("cuenta_id")
  fecha              DateTime                 @default(now()) @map("fecha")
  tipo               TipoMovimientoFinanciero
  montoIngreso       Decimal                  @default(0.00) @map("monto_ingreso") @db.Decimal(12, 2)
  montoEgreso        Decimal                  @default(0.00) @map("monto_egreso") @db.Decimal(12, 2)
  conceptoTexto      String                   @map("concepto_texto") @db.VarChar(300)
  pagoId             Int?                     @map("pago_id")
  gastoId            Int?                     @map("gasto_id")
  rubroId              Int?                     @map("rubro_id")
  pedidoEventoId       Int?                     @map("pedido_evento_id")
  transferenciaGrupoId String?                  @map("transferencia_grupo_id") @db.Uuid
  creadoPorUsuarioId   Int                      @map("creado_por_usuario_id")
  createdAt            DateTime                 @default(now()) @map("created_at")

  cuenta               CuentaFinanciera         @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  pago                 Pago?                    @relation(fields: [pagoId], references: [id], onDelete: Restrict)
  gasto                Gasto?                   @relation(fields: [gastoId], references: [id], onDelete: Restrict)
  rubro                RubroContable?           @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  pedidoEvento         PedidoEvento?            @relation(fields: [pedidoEventoId], references: [id], onDelete: Restrict)
  creadoPor            Usuario                  @relation("MovimientosCreados", fields: [creadoPorUsuarioId], references: [id])

  @@index([cuentaId, fecha])
  @@index([pagoId])
  @@index([gastoId])
  @@index([rubroId])
  @@index([pedidoEventoId])
  @@index([transferenciaGrupoId])
  @@map("movimientos_financieros")
}

enum TipoRubro {
  INGRESO
  EGRESO
}

model RubroContable {
  id                      Int                    @id @default(autoincrement())
  nombre                  String                 @db.VarChar(100)
  tipo                    TipoRubro
  unidadId                Int?                   @map("unidad_id")
  permiteDescuentoDefault Boolean                @default(false) @map("permite_descuento_default")
  activo                  Boolean                @default(true)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  unidad                  UnidadOrganizativa?    @relation(fields: [unidadId], references: [id], onDelete: SetNull)
  conceptos               ConceptoCuota[]
  planesCuota             PlanCuotaMensual[]
  gastos                  Gasto[]
  movimientos             MovimientoFinanciero[]
  eventos                 Evento[]

  @@unique([nombre, tipo])
  @@map("rubros_contables")
}

model Gasto {
  id                 Int                    @id @default(autoincrement())
  fecha              DateTime               @default(now()) @map("fecha")
  monto              Decimal                @db.Decimal(12, 2)
  descripcion        String                 @db.VarChar(300)
  rubroId            Int                    @map("rubro_id")
  cuentaId           Int                    @map("cuenta_id")
  comprobanteNro     String?                @map("comprobante_nro") @db.VarChar(100)
  comprobanteUrl     String?                @map("comprobante_url") @db.VarChar(500)
  anulado            Boolean                @default(false)
  registradoPorId    Int                    @map("registrado_por_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  rubro              RubroContable          @relation(fields: [rubroId], references: [id], onDelete: Restrict)
  cuenta             CuentaFinanciera       @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  registradoPor      Usuario                @relation("GastosRegistrados", fields: [registradoPorId], references: [id])
  movimientos        MovimientoFinanciero[]

  @@index([fecha])
  @@index([rubroId])
  @@index([cuentaId])
  @@map("gastos")
}

// -------------------------------------------------------------
// EVENTOS ECONÓMICOS, PEDIDOS Y TICKETS QR (FASE 4)
// -------------------------------------------------------------

enum TipoEvento {
  RECAUDACION_PEDIDOS
  FESTIVAL_ENTRADAS
}

enum EstadoEvento {
  BORRADOR
  PUBLICADO
  FINALIZADO
  CANCELADO
}

enum EstadoPedidoEvento {
  PENDIENTE
  PAGADO
  CANCELADO
}

enum EstadoTicketEvento {
  ACTIVO
  UTILIZADO
  CANCELADO
}

model Evento {
  id                 Int              @id @default(autoincrement())
  titulo             String           @db.VarChar(150)
  descripcion        String?          @db.Text
  tipo               TipoEvento       @default(RECAUDACION_PEDIDOS)
  estado             EstadoEvento     @default(BORRADOR)
  fechaEvento        DateTime         @map("fecha_evento")
  fechaFin           DateTime?        @map("fecha_fin")
  lugarEntrega       String?          @map("lugar_entrega") @db.VarChar(200)
  rubroId            Int?             @map("rubro_id")
  cuentaId           Int?             @map("cuenta_id")
  creadoPorUsuarioId Int              @map("creado_por_usuario_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  rubro              RubroContable?   @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  cuenta             CuentaFinanciera? @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  creadoPor          Usuario          @relation("EventosCreados", fields: [creadoPorUsuarioId], references: [id])
  items              ItemEvento[]
  pedidos            PedidoEvento[]

  @@map("eventos")
}

model ItemEvento {
  id               Int                   @id @default(autoincrement())
  eventoId         Int                   @map("evento_id")
  nombre           String                @db.VarChar(100)
  descripcion      String?               @db.Text
  precioVenta      Decimal               @map("precio_venta") @db.Decimal(12, 2)
  costoUnitario    Decimal               @default(0.00) @map("costo_unitario") @db.Decimal(12, 2)
  gananciaUnitaria Decimal               @default(0.00) @map("ganancia_unitaria") @db.Decimal(12, 2)
  stockTotal       Int?                  @map("stock_total")
  stockDisponible  Int?                  @map("stock_disponible")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  evento           Evento                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  detallesPedido   DetallePedidoEvento[]
  tickets          TicketEvento[]

  @@map("items_evento")
}

model PedidoEvento {
  id                     Int                   @id @default(autoincrement())
  eventoId               Int                   @map("evento_id")
  compradorNombre        String                @map("comprador_nombre") @db.VarChar(120)
  compradorContacto      String?               @map("comprador_contacto") @db.VarChar(100)
  vendedorUsuarioId      Int?                  @map("vendedor_usuario_id")
  total                  Decimal               @db.Decimal(12, 2)
  totalGanancia          Decimal               @default(0.00) @map("total_ganancia") @db.Decimal(12, 2)
  gananciaAcreditada     Boolean               @default(false) @map("ganancia_acreditada")
  fechaAcreditacion      DateTime?             @map("fecha_acreditacion")
  estado                 EstadoPedidoEvento    @default(PENDIENTE)
  metodoPago             MetodoPago?           @map("metodo_pago")
  cuentaId               Int?                  @map("cuenta_id")
  registradoPorUsuarioId Int                   @map("registrado_por_usuario_id")
  observaciones          String?               @db.Text
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  evento                 Evento                @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  vendedorUsuario        Usuario?              @relation("PedidosVendidos", fields: [vendedorUsuarioId], references: [id])
  registradoPor          Usuario               @relation("PedidosRegistrados", fields: [registradoPorUsuarioId], references: [id])
  cuenta                 CuentaFinanciera?     @relation(fields: [cuentaId], references: [id], onDelete: SetNull)
  detalles               DetallePedidoEvento[]
  tickets                TicketEvento[]
  movimientos            MovimientoFinanciero[]

  @@index([eventoId, estado])
  @@index([vendedorUsuarioId])
  @@map("pedidos_evento")
}

model DetallePedidoEvento {
  id               Int          @id @default(autoincrement())
  pedidoId         Int          @map("pedido_id")
  itemId           Int          @map("item_id")
  cantidad         Int
  precioUnitario   Decimal      @map("precio_unitario") @db.Decimal(12, 2)
  subtotal         Decimal      @db.Decimal(12, 2)
  gananciaUnitaria Decimal      @default(0.00) @map("ganancia_unitaria") @db.Decimal(12, 2)
  subtotalGanancia Decimal      @default(0.00) @map("subtotal_ganancia") @db.Decimal(12, 2)

  pedido           PedidoEvento @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item             ItemEvento   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("detalles_pedido_evento")
}

model TicketEvento {
  id                 Int                @id @default(autoincrement())
  pedidoId           Int                @map("pedido_id")
  itemId             Int                @map("item_id")
  tokenQr            String             @unique @map("token_qr") @db.VarChar(120)
  cantidad           Int                @default(1)
  estado             EstadoTicketEvento @default(ACTIVO)
  fechaUso           DateTime?          @map("fecha_uso")
  validadorUsuarioId Int?               @map("validador_usuario_id")
  createdAt          DateTime           @default(now()) @map("created_at")

  pedido             PedidoEvento       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item               ItemEvento         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  validador          Usuario?           @relation("TicketsValidados", fields: [validadorUsuarioId], references: [id])

  @@index([pedidoId, estado])
  @@index([itemId])
  @@map("tickets_evento")
}

model ConfiguracionCorreo {
  id            Int      @id @default(1)
  habilitado    Boolean  @default(true)
  host          String?  @db.VarChar(255)
  port          Int      @default(587)
  user          String?  @db.VarChar(255)
  passEncrypted String?  @map("pass_encrypted") @db.Text
  from          String?  @db.VarChar(255)
  appUrl        String?  @map("app_url") @db.VarChar(255)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("configuracion_correo")
}
