# PostgreSQL 16+ (en Neon usar el host SIN "-pooler" para prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scout_app?sslmode=require"

SEED_CICLO_ANIO=2026

SEED_ADMIN_DNI="00000000"
SEED_ADMIN_PASSWORD="00000000"
SEED_ADMIN_NOMBRE="Admin"
SEED_ADMIN_APELLIDO="Jefatura"
SEED_ADMIN_FECHA_NACIMIENTO="1990-01-01"

# JWT (m�nimo 32 caracteres aleatorios)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-32+-chars"
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Secreto HMAC para tokens QR de eventos (m�nimo 32 caracteres aleatorios)
QR_HMAC_SECRET="cambiar-por-un-secreto-hmac-qr-de-32+-chars"

# URL pública del frontend (usada en los enlaces de los correos)
APP_URL="http://localhost:5173"

# Configuración SMTP saliente para envío de credenciales por correo (opcional)
# Ejemplo con Gmail (usar Contraseña de Aplicación de 16 caracteres, NO la clave normal):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_USER="tu-cuenta@gmail.com"
#   SMTP_PASS="xxxx xxxx xxxx xxxx"
#   SMTP_FROM='"Grupo Scout Juan XXIII" <tu-cuenta@gmail.com>'
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
